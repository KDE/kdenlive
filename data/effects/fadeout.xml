<?xml version="1.0"?>
<!DOCTYPE kpartgui>
<effect xmlns="https://www.kdenlive.org" tag="volume" id="fadeout" type="audio" unique="1">
    <name context="Audio Fade Out Effect Name">Fade out</name>
    <description>Fade out audio track</description>
    <author/>
    <parameter type="position" name="in" max="0" min="0" default="-%fade">
        <name>Duration</name>
    </parameter>
    <parameter type="fixed" name="out" max="90000" min="0" default="%out">
        <name/>
    </parameter>
    <parameter type="multiswitch" name="level" default="0d=0;-1=-60" min="0d=0;-1=-60" max="0d=0;-1=-60" curves="d;g;j;m;p">
        <name>Fade Out</name>
    </parameter>
</effect>
