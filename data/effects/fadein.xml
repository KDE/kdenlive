<?xml version="1.0"?>
<!DOCTYPE kpartgui>
<effect xmlns="https://www.kdenlive.org" tag="volume" id="fadein" type="audio" unique="1">
    <name context="Audio Fade In Effect Name">Fade in</name>
    <description>Fade in audio track</description>
    <author/>
    <parameter type="fixed" name="in" max="0" min="0" default="0">
        <name/>
    </parameter>
    <parameter type="position" name="out" max="90000" min="0" default="%fade">
        <name>Duration</name>
    </parameter>
    <parameter type="multiswitch" name="level" default="0e=-60;-1=0" min="0e=-60;-1=0" max="0e=-60;-1=0" curves="e;h;k;n;q">
        <name>Fade In</name>
    </parameter>
</effect>
