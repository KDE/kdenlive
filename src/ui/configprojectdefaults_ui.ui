 <class>ConfigProjectDefaults_UI</class>
 <widget class="QWidget" name="ConfigProjectDefaults_UI">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>525</width>
    <height>480</height>
   </rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="KMessageWidget" name="kmessagewidget">
