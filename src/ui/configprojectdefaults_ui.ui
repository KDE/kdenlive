      <string>These are the default settings for new projects. To edit the parameters of the current project, use the project settings.</string>
     </property>
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="closeButtonVisible">
      <bool>false</bool>
     </property>
