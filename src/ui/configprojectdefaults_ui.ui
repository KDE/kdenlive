     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="tab_settings">
      <attribute name="title">
       <string>Settings</string>
      </attribute>
      <layout class="QVBoxLayout" name="layout_settings"/>
